{
  "functions": {
    "api/ingest.js": { "maxDuration": 30, "memory": 512 }
  },
  "redirects": [
    { "source": "/", "destination": "/dashboard", "permanent": false }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/actions",   "destination": "/actions.html"   },
    { "source": "/projects",  "destination": "/projects.html"  },
    { "source": "/record",    "destination": "/record.html"    },
    { "source": "/today",     "destination": "/today.html"     },
    { "source": "/settings",  "destination": "/settings.html"  },
    { "source": "/context",   "destination": "/context.html"   }
  ]
}

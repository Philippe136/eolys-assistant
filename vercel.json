{
  "functions": {
    "api/ingest.js": { "maxDuration": 30, "memory": 512 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.vercel.app https://*.trigger.dev; media-src 'self' https://*.public.blob.vercel-storage.com; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/dashboard", "permanent": false }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/public/pages/dashboard.html" },
    { "source": "/actions",   "destination": "/public/pages/actions.html"   },
    { "source": "/projects",  "destination": "/public/pages/projects.html"  },
    { "source": "/record",    "destination": "/public/pages/record.html"    },
    { "source": "/today",     "destination": "/public/pages/today.html"     },
    { "source": "/settings",  "destination": "/public/pages/settings.html"  },
    { "source": "/context",   "destination": "/public/pages/context.html"   },
    { "source": "/patterns",  "destination": "/public/pages/patterns.html"  },
    { "source": "/radar",     "destination": "/public/pages/radar.html"     },
    { "source": "/gmail",     "destination": "/public/pages/gmail.html"     },
    { "source": "/insights",  "destination": "/public/pages/insights.html"  },
    { "source": "/folders",   "destination": "/public/pages/folders.html"   },
    { "source": "/finance",   "destination": "/public/pages/finance.html"   },

    { "source": "/app.css",            "destination": "/public/css/app.css"              },
    { "source": "/app.js",             "destination": "/public/js/app.js"                },
    { "source": "/sw.js",              "destination": "/public/sw.js"                    },
    { "source": "/manifest.json",      "destination": "/public/manifest.json"            },
    { "source": "/icon-192.png",       "destination": "/public/icons/icon-192.png"       },
    { "source": "/icon-512.png",       "destination": "/public/icons/icon-512.png"       },
    { "source": "/apple-touch-icon.png","destination": "/public/icons/apple-touch-icon.png" }
  ]
}
